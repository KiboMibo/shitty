# The build runner publishes a convenience symlink at the repo root for
# every requested target, named after the target - an open-ended set
# that grows with build.py. Ignore the whole root and whitelist the
# sources instead of chasing names; a new real root file needs its own
# ! line here, which is deliberate.
/*
!/.clang-format
!/.github
!/.gitignore
!/CLAUDE.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE.GPL3
!/LICENSE.MIT
!/README.md
!/STYLE.md
!/STYLE_PRJ.md
!/bin
!/build
!/build.py
!/codecov.yml
!/dev
!/docs
!/ext
!/flake.lock
!/flake.nix
!/lib
!/shell.nix
!/tst

# Anywhere in the tree.
__pycache__/
.codegraph/
/bounce*.log
/ext/plt/plt_unit_tests
/ext/plt/plt_wayland_integration_tests

# compiled one-off probes
dev/probes/*
!dev/probes/*.c
!dev/probes/*.cpp
!dev/probes/*.m
!dev/probes/*.mm
!dev/probes/*.toml
!dev/probes/README.md

# agent tooling state - operational artefacts, never part of the tree
.DS_Store
.omc/
.repowise/
