#version 450

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

@OUTPUT_DECLARATION@

struct Cell
{
   uint codepoint;
   uint charData;
   uint fg;
   uint bg;
   uint underlineColor;
   uint hyperlink;
   uint strip;
   uint stripStride;
   uint semantic;
   uint lineAttribute;
};

struct CellUpdate
{
   uint sourceIndex;
   uint outputIndex;
   Cell cell;
};

layout (std430, set = 0, binding = 1) readonly buffer CellBuffer
{
   CellUpdate updates[];
};

layout (std430, set = 0, binding = 2) readonly buffer MaskArena
{
   uint maskArena[];
};

layout (std430, set = 0, binding = 3) readonly buffer ColorArena
{
   uint colorArena[];
};

layout (push_constant) uniform PushConstants
{
   uint glyphWidth;
   uint glyphHeight;
   uint columns;
   uint rows;
   uint outputWidth;
   uint outputHeight;
   uint border;
   uint cursorColor;
   int cursorX;
   int cursorY;
   uint cursorStyle;
   uint screenReverseVideo;
   int selectionLeft;
   int selectionTop;
   int selectionRight;
   int selectionBottom;
   uint rectangularSelection;
   uint showWraps;
   uint selectionForeground;
   uint selectionBackground;
   uint selectionColorMask;
   uint blinkVisible;
   uint cursorBlink;
   uint hoveredHyperlink;
   uint hoveredLinkBegin;
   uint hoveredLinkEnd;
   uint updateCount;
} parameters;

vec3 unpackColor (uint color)
{
   return vec3 (
      float (bitfieldExtract (color, 0, 8)),
      float (bitfieldExtract (color, 8, 8)),
      float (bitfieldExtract (color, 16, 8))) / 255.0;
}

void storePixel (ivec2 position, vec3 color)
{
   if (position.x < 0 || position.y < 0 ||
       position.x >= int (parameters.outputWidth) ||
       position.y >= int (parameters.outputHeight))
      return;
@OUTPUT_STORE@
}

bool selectedCoordinate (ivec2 cellPosition)
{
   if (parameters.rectangularSelection != 0)
   {
      return cellPosition.y >= parameters.selectionTop &&
             cellPosition.y <= parameters.selectionBottom &&
             cellPosition.x >= parameters.selectionLeft &&
             cellPosition.x < parameters.selectionRight;
   }

   return
      (cellPosition.y > parameters.selectionTop &&
       cellPosition.y < parameters.selectionBottom) ||
      (cellPosition.y == parameters.selectionTop &&
       cellPosition.x >= parameters.selectionLeft &&
       (cellPosition.y < parameters.selectionBottom ||
        cellPosition.x < parameters.selectionRight)) ||
      (cellPosition.y == parameters.selectionBottom &&
       cellPosition.x < parameters.selectionRight &&
       (cellPosition.y > parameters.selectionTop ||
        cellPosition.x > parameters.selectionLeft));
}

bool selected (ivec2 cellPosition, uint doubleWidth)
{
   return selectedCoordinate (cellPosition) ||
          (doubleWidth != 0 &&
           selectedCoordinate (cellPosition + ivec2 (1, 0)));
}

const uint boxDrawingData [128] = uint [128] (
   0x0005u, 0x000au, 0x0050u, 0x00a0u,
   0x6005u, 0x600au, 0x6050u, 0x60a0u,
   0x8005u, 0x800au, 0x8050u, 0x80a0u,
   0x0044u, 0x0048u, 0x0084u, 0x0088u,
   0x0041u, 0x0042u, 0x0081u, 0x0082u,
   0x0014u, 0x0018u, 0x0024u, 0x0028u,
   0x0011u, 0x0012u, 0x0021u, 0x0022u,
   0x0054u, 0x0058u, 0x0064u, 0x0094u,
   0x00a4u, 0x0068u, 0x0098u, 0x00a8u,
   0x0051u, 0x0052u, 0x0061u, 0x0091u,
   0x00a1u, 0x0062u, 0x0092u, 0x00a2u,
   0x0045u, 0x0046u, 0x0049u, 0x004au,
   0x0085u, 0x0086u, 0x0089u, 0x008au,
   0x0015u, 0x0016u, 0x0019u, 0x001au,
   0x0025u, 0x0026u, 0x0029u, 0x002au,
   0x0055u, 0x0056u, 0x0059u, 0x005au,
   0x0065u, 0x0095u, 0x00a5u, 0x0066u,
   0x0069u, 0x0096u, 0x0099u, 0x006au,
   0x009au, 0x00a6u, 0x00a9u, 0x00aau,
   0x4005u, 0x400au, 0x4050u, 0x40a0u,
   0x000fu, 0x00f0u, 0x004cu, 0x00c4u,
   0x00ccu, 0x0043u, 0x00c1u, 0x00c3u,
   0x001cu, 0x0034u, 0x003cu, 0x0013u,
   0x0031u, 0x0033u, 0x005cu, 0x00f4u,
   0x00fcu, 0x0053u, 0x00f1u, 0x00f3u,
   0x004fu, 0x00c5u, 0x00cfu, 0x001fu,
   0x0035u, 0x003fu, 0x005fu, 0x00f5u,
   0x00ffu, 0x0444u, 0x0441u, 0x0411u,
   0x0414u, 0x0800u, 0x1000u, 0x1800u,
   0x0001u, 0x0010u, 0x0004u, 0x0040u,
   0x0002u, 0x0020u, 0x0008u, 0x0080u,
   0x0009u, 0x0090u, 0x0006u, 0x0060u);

bool inBand (int coordinate, int center, int thickness)
{
   int first = center - (thickness - 1) / 2;
   return coordinate >= first && coordinate < first + thickness;
}

bool inDash (int coordinate, int length, uint count)
{
   if (count == 0)
      return true;

   int partCount = int (count * 2 - 1);
   int part = coordinate * partCount / length;
   return (part & 1) == 0;
}

bool inStroke (int coordinate, int center, uint weight,
               int lightThickness, int heavyThickness)
{
   if (weight == 1)
      return inBand (coordinate, center, lightThickness);
   if (weight == 2)
      return inBand (coordinate, center, heavyThickness);
   return false;
}

bool directionGraph (ivec2 pixel, ivec2 center, uint data, int thickness)
{
   uint left = bitfieldExtract (data, 0, 2);
   uint right = bitfieldExtract (data, 2, 2);
   uint up = bitfieldExtract (data, 4, 2);
   uint down = bitfieldExtract (data, 6, 2);
   return
      (left == 3 && pixel.x <= center.x &&
       inBand (pixel.y, center.y, thickness)) ||
      (right == 3 && pixel.x >= center.x &&
       inBand (pixel.y, center.y, thickness)) ||
      (up == 3 && pixel.y <= center.y &&
       inBand (pixel.x, center.x, thickness)) ||
      (down == 3 && pixel.y >= center.y &&
       inBand (pixel.x, center.x, thickness));
}

float diagonalCoverage (ivec2 pixel, ivec2 size, uint data,
                        int lightThickness)
{
   vec2 position = vec2 (pixel) + vec2 (0.5);
   vec2 dimensions = vec2 (size);
   float normalLength = length (dimensions);
   float distance = dimensions.y * position.x -
                    dimensions.x * position.y;
   float otherDistance = dimensions.y * position.x +
                         dimensions.x * position.y -
                         dimensions.x * dimensions.y;
   float nearest = 1e10;
   if ((data & 0x0800u) != 0)
      nearest = min (nearest, abs (otherDistance) / normalLength);
   if ((data & 0x1000u) != 0)
      nearest = min (nearest, abs (distance) / normalLength);
   float halfWidth = float (lightThickness) * 0.5;
   return 1.0 - smoothstep (halfWidth, halfWidth + 1.0, nearest);
}

float arcCoverage (ivec2 pixel, ivec2 size, uint data,
                   int lightThickness)
{
   int centerX = size.x / 2;
   int centerY = size.y / 2;
   bool left = (data & 0x0003u) != 0;
   bool up = (data & 0x0030u) != 0;
   vec2 corner = vec2 (left ? 0 : size.x, up ? 0 : size.y);
   vec2 radius = vec2 (
      left ? centerX : size.x - centerX,
      up ? centerY : size.y - centerY);
   vec2 position = vec2 (pixel) + vec2 (0.5);
   vec2 direction = (position - corner) / radius;
   bool quadrant =
      (left ? position.x <= centerX : position.x >= centerX) &&
      (up ? position.y <= centerY : position.y >= centerY);
   if (!quadrant)
      return 0.0;
   float distance = abs (length (direction) - 1.0) *
                    min (radius.x, radius.y);
   float halfWidth = float (lightThickness) * 0.5;
   return 1.0 - smoothstep (halfWidth, halfWidth + 1.0, distance);
}

float boxDrawingCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   uint data = boxDrawingData [codepoint - 0x2500u];
   int centerX = size.x / 2;
   int centerY = size.y / 2;
   int lightThickness = max (1, min (size.x, size.y) / 12);
   int heavyThickness = max (lightThickness + 1, lightThickness * 2);

   if ((data & 0x1800u) != 0)
      return diagonalCoverage (pixel, size, data, lightThickness);
   if ((data & 0x0400u) != 0)
      return arcCoverage (pixel, size, data, lightThickness);

   uint dashCount = bitfieldExtract (data, 13, 3);
   uint left = bitfieldExtract (data, 0, 2);
   uint right = bitfieldExtract (data, 2, 2);
   uint up = bitfieldExtract (data, 4, 2);
   uint down = bitfieldExtract (data, 6, 2);
   bool horizontalDash = inDash (
      pixel.x, size.x, dashCount);
   bool verticalDash = inDash (
      pixel.y, size.y, dashCount);

   bool covered =
      (left != 0 && pixel.x <= centerX && horizontalDash &&
       inStroke (
          pixel.y, centerY, left, lightThickness, heavyThickness)) ||
      (right != 0 && pixel.x >= centerX && horizontalDash &&
       inStroke (
          pixel.y, centerY, right, lightThickness, heavyThickness)) ||
      (up != 0 && pixel.y <= centerY && verticalDash &&
       inStroke (
          pixel.x, centerX, up, lightThickness, heavyThickness)) ||
      (down != 0 && pixel.y >= centerY && verticalDash &&
       inStroke (
          pixel.x, centerX, down, lightThickness, heavyThickness));
   ivec2 center = ivec2 (centerX, centerY);
   bool doubleOuter = directionGraph (
      pixel, center, data, lightThickness * 3);
   bool doubleInner = directionGraph (
      pixel, center, data, lightThickness);
   covered = covered || (doubleOuter && !doubleInner);
   return covered ? 1.0 : 0.0;
}

float blockCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   if (codepoint >= 0x2591u && codepoint <= 0x2593u)
   {
      // The shades as an ordered 4x4 Bayer pattern: pixel-stable at 4,
      // 8, and 12 sixteenths.
      const int bayer [16] = int [16] (0, 8, 2, 10, 12, 4, 14, 6,
                                       3, 11, 1, 9, 15, 7, 13, 5);
      int level = int (codepoint - 0x2590u) * 4;
      return bayer [(pixel.y & 3) * 4 + (pixel.x & 3)] < level ? 1.0 : 0.0;
   }
   int x0 = 0;
   int x1 = 8;
   int y0 = 0;
   int y1 = 8;
   if (codepoint == 0x2580u)
      y1 = 4;
   else if (codepoint <= 0x2588u)
      y0 = 8 - int (codepoint - 0x2580u);
   else if (codepoint <= 0x258fu)
      x1 = 8 - int (codepoint - 0x2588u);
   else if (codepoint == 0x2590u)
      x0 = 4;
   else if (codepoint == 0x2594u)
      y1 = 1;
   else if (codepoint == 0x2595u)
      x0 = 7;
   else
   {
      // Quadrant bits: 1 upper left, 2 upper right, 4 lower left,
      // 8 lower right.
      const uint quadrants [10] = uint [10] (
         0x4u, 0x8u, 0x1u, 0xdu, 0x9u, 0x7u, 0xbu, 0x2u, 0x6u, 0xeu);
      uint mask = quadrants [codepoint - 0x2596u];
      int quadrantX = pixel.x < size.x * 4 / 8 ? 0 : 1;
      int quadrantY = pixel.y < size.y * 4 / 8 ? 0 : 1;
      return (mask & (1u << uint (quadrantY * 2 + quadrantX))) != 0u
         ? 1.0 : 0.0;
   }
   bool inside =
      pixel.x >= size.x * x0 / 8 && pixel.x < size.x * x1 / 8 &&
      pixel.y >= size.y * y0 / 8 && pixel.y < size.y * y1 / 8;
   return inside ? 1.0 : 0.0;
}

float scanLineCoverage (uint codepoint, ivec2 pixel, ivec2 size)
{
   const int positions [4] = int [4] (1, 3, 7, 9);
   int center = size.y * positions [codepoint - 0x23bau] / 10;
   int thickness = max (1, min (size.x, size.y) / 12);
   return inBand (pixel.y, center, thickness) ? 1.0 : 0.0;
}

bool nonRenderingCodepoint (uint codepoint)
{
   return codepoint == 0x200du ||
          (codepoint >= 0xfe00u && codepoint <= 0xfe0fu) ||
          (codepoint >= 0xe0100u && codepoint <= 0xe01efu);
}

float glyphCoverage (uint codepoint, uint strip, uint stripStride,
                     uint lineAttribute, ivec2 pixel, ivec2 cellSize,
                     out vec4 intrinsicColor)
{
   intrinsicColor = vec4 (0.0);
   if (strip == 0xffffffffu)
   {
      if (nonRenderingCodepoint (codepoint))
         return 0.0;
      if (codepoint >= 0x2500u && codepoint <= 0x257fu)
         return boxDrawingCoverage (codepoint, pixel, cellSize);
      if (codepoint >= 0x2580u && codepoint <= 0x259fu)
         return blockCoverage (codepoint, pixel, cellSize);
      if (codepoint >= 0x23bau && codepoint <= 0x23bdu)
         return scanLineCoverage (codepoint, pixel, cellSize);
      return 0.0;
   }

   // The strips hold single-density slices; double-size lines sample
   // them at half rate. pixel arrives in the doubled coordinate space.
   int sampleX = lineAttribute != 0u ? pixel.x / 2 : pixel.x;
   int sampleY = lineAttribute == 2u || lineAttribute == 3u
      ? pixel.y / 2 : lineAttribute == 1u && pixel.y >= int (parameters.glyphHeight)
      ? pixel.y - int (parameters.glyphHeight) : pixel.y;
   uint index = (strip & 0x7fffffffu) +
                uint (sampleY) * stripStride + uint (sampleX);
   if ((strip & 0x80000000u) != 0u)
   {
      uint texel = colorArena[index];
      intrinsicColor = vec4 (
         float (texel & 0xffu),
         float ((texel >> 8u) & 0xffu),
         float ((texel >> 16u) & 0xffu),
         float ((texel >> 24u) & 0xffu)) / 255.0;
      return 0.0;
   }
   uint texel = maskArena[index >> 2u];
   return float ((texel >> (8u * (index & 3u))) & 0xffu) / 255.0;
}

void main ()
{
   uint updateIndex = gl_GlobalInvocationID.x;
   if (updateIndex >= parameters.updateCount)
      return;

   CellUpdate update = updates [updateIndex];
   uint sourceRow = update.sourceIndex / parameters.columns;
   uint sourceColumn = update.sourceIndex -
                       sourceRow * parameters.columns;
   uint outputRow = update.outputIndex / parameters.columns;
   uint outputColumn = update.outputIndex -
                       outputRow * parameters.columns;
   if (sourceColumn >= parameters.columns ||
       sourceRow >= parameters.rows ||
       outputColumn >= parameters.columns ||
       outputRow >= parameters.rows)
      return;

   uvec2 globalPosition = uvec2 (outputColumn, outputRow);
   ivec2 cellPosition = ivec2 (sourceColumn, sourceRow);
   uint lineAttribute = update.cell.lineAttribute;
   bool doubleLine = lineAttribute != 0;
   Cell cell = update.cell;

   uint doubleWidth = doubleLine ? 1u : bitfieldExtract (cell.charData, 16, 1);
   uint underline = bitfieldExtract (cell.charData, 4, 1);
   uint inverse = bitfieldExtract (cell.charData, 5, 1);
   uint wrap = bitfieldExtract (cell.charData, 6, 1);
   uint faint = bitfieldExtract (cell.charData, 8, 1);
   uint blink = bitfieldExtract (cell.charData, 9, 1);
   uint conceal = bitfieldExtract (cell.charData, 10, 1);
   uint strike = bitfieldExtract (cell.charData, 11, 1);
   uint overline = bitfieldExtract (cell.charData, 12, 1);
   uint underlineStyle = bitfieldExtract (cell.charData, 13, 3);
   uint codepoint = cell.codepoint;
   vec3 foreground = unpackColor (cell.fg);
   vec3 background = unpackColor (cell.bg);
   vec3 cursor = unpackColor (parameters.cursorColor);
   vec3 underlineColor = unpackColor (cell.underlineColor);

   if ((inverse != 0) != (parameters.screenReverseVideo != 0))
   {
      vec3 temporary = foreground;
      foreground = background;
      background = temporary;
   }
   if (selected (cellPosition, doubleWidth))
   {
      if (parameters.selectionColorMask == 0)
      {
         vec3 temporary = foreground;
         foreground = background;
         background = temporary;
      }
      else
      {
         if ((parameters.selectionColorMask & 1u) != 0)
            foreground = unpackColor (parameters.selectionForeground);
         if ((parameters.selectionColorMask & 2u) != 0)
            background = unpackColor (parameters.selectionBackground);
      }
   }
   if (faint != 0)
      foreground = mix (foreground, background, 0.5);
   if (conceal != 0)
      foreground = background;
   if (blink != 0 && parameters.blinkVisible == 0)
      foreground = background;
   bool explicitLink = cell.hyperlink != 0 &&
      cell.hyperlink == parameters.hoveredHyperlink;
   bool plainLink = update.sourceIndex >= parameters.hoveredLinkBegin &&
      update.sourceIndex < parameters.hoveredLinkEnd;
   if (underline == 0 && (explicitLink || plainLink))
   {
      underline = 1;
      underlineStyle = 1;
      underlineColor = foreground;
   }
   if (all (equal (cursor, background)))
      cursor = vec3 (1.0) - cursor;

   bool cursorHere = cellPosition.x == parameters.cursorX &&
                     cellPosition.y == parameters.cursorY;
   cursorHere = cursorHere &&
      (parameters.cursorBlink == 0 || parameters.blinkVisible != 0);
   if (cursorHere && parameters.cursorStyle == 1)
   {
      foreground = background;
      background = cursor;
   }

   uint cellWidth = parameters.glyphWidth;
   ivec2 outputOrigin = ivec2 (
      int (parameters.border + globalPosition.x * parameters.glyphWidth),
      int (parameters.border + globalPosition.y * parameters.glyphHeight));

   for (uint y = 0; y < parameters.glyphHeight; ++y)
   {
      for (uint x = 0; x < cellWidth; ++x)
      {
         ivec2 pixel = ivec2 (
            int (x + (doubleLine ? (globalPosition.x & 1u) *
                                  parameters.glyphWidth : 0u)),
            int (y + (lineAttribute == 2u ? parameters.glyphHeight : 0u)));
         ivec2 size = ivec2 (
            doubleLine ? parameters.glyphWidth * 2u : cellWidth,
            lineAttribute == 1u || lineAttribute == 2u
               ? parameters.glyphHeight * 2u : parameters.glyphHeight);
         vec4 intrinsicColor;
         float coverage = glyphCoverage (
            codepoint, cell.strip, cell.stripStride, lineAttribute,
            pixel, size, intrinsicColor);
         vec3 color;
         if (intrinsicColor.a != 0.0 &&
             conceal == 0 &&
             (blink == 0 || parameters.blinkVisible != 0))
         {
            if (faint != 0)
               intrinsicColor *= 0.5;
            color = intrinsicColor.rgb +
                    background * (1.0 - intrinsicColor.a);
         }
         else
         {
            color = foreground * coverage +
                    background * (1.0 - coverage);
         }
         storePixel (outputOrigin + pixel, color);
      }
   }

   if (underline != 0)
   {
      for (uint x = 0; x < cellWidth; ++x)
      {
         bool draw = underlineStyle != 4 || (x & 1u) == 0u;
         draw = draw && (underlineStyle != 5 || (x % 6u) < 4u);
         uint waveY = underlineStyle == 3 ? (x & 1u) : 0u;
         if (draw)
            storePixel (
               outputOrigin + ivec2 (
                  x, parameters.glyphHeight - 1 - int (waveY)),
               underlineColor);
         if (underlineStyle == 2 && parameters.glyphHeight > 2)
            storePixel (
               outputOrigin + ivec2 (x, parameters.glyphHeight - 3),
               underlineColor);
      }
   }

   if (strike != 0)
      for (uint x = 0; x < cellWidth; ++x)
         storePixel (
            outputOrigin + ivec2 (x, parameters.glyphHeight / 2),
            foreground);

   if (overline != 0)
      for (uint x = 0; x < cellWidth; ++x)
         storePixel (outputOrigin + ivec2 (x, 0), foreground);

   if (parameters.showWraps != 0 && wrap != 0)
   {
      for (uint y = 0; y < parameters.glyphHeight; y += 2)
         storePixel (
            outputOrigin + ivec2 (cellWidth - 1, y), foreground);
   }

   if (cursorHere && parameters.cursorStyle == 2)
   {
      for (uint x = 0; x < cellWidth; ++x)
      {
         storePixel (outputOrigin + ivec2 (x, 0), cursor);
         storePixel (
            outputOrigin + ivec2 (x, parameters.glyphHeight - 1), cursor);
      }
      for (uint y = 1; y + 1 < parameters.glyphHeight; ++y)
      {
         storePixel (outputOrigin + ivec2 (0, y), cursor);
         storePixel (outputOrigin + ivec2 (cellWidth - 1, y), cursor);
      }
   }
   else if (cursorHere && parameters.cursorStyle == 3)
   {
      uint thickness = max (1u, parameters.glyphHeight / 8u);
      for (uint y = parameters.glyphHeight - thickness;
           y < parameters.glyphHeight; ++y)
      {
         for (uint x = 0; x < cellWidth; ++x)
            storePixel (outputOrigin + ivec2 (x, y), cursor);
      }
   }
   else if (cursorHere && parameters.cursorStyle == 4)
   {
      uint thickness = max (1u, parameters.glyphWidth / 6u);
      for (uint y = 0; y < parameters.glyphHeight; ++y)
      {
         for (uint x = 0; x < thickness; ++x)
            storePixel (outputOrigin + ivec2 (x, y), cursor);
      }
   }
}
